        function renderLiveFeed() {
            const grid = document.getElementById('liveFeedGrid');
            if(!grid) return;
            
            if(LIVE_FEED_DATA.length === 0) {
                grid.innerHTML = `<div class="col-span-full text-center py-12 text-mutedText border border-dashed border-borderLight rounded-xl">Лента пуста. Добавьте видео или фото через админку.</div>`;
                return;
            }

            grid.innerHTML = LIVE_FEED_DATA.map((item, idx) => {
                const delay = (idx % 3) * 100;
                
                if(item.type === 'video') {
                    return `
                    <div class="reveal-element rounded-2xl overflow-hidden shadow-lg border border-borderLight relative group h-[400px] bg-black" style="transition-delay: ${delay}ms;">
                        <video src="${item.src}" playsinline autoplay loop muted class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"></video>
                    </div>`;
                } else {
                    return `
                    <div class="reveal-element rounded-2xl overflow-hidden shadow-lg border border-borderLight relative group h-[400px]" style="transition-delay: ${delay}ms;" onclick="openLightbox('${item.src}')">
                        <img src="${item.src}" class="w-full h-full object-cover cursor-pointer transition-transform duration-700 group-hover:scale-110 enhanced-img">
                    </div>`;
                }
            }).join('');
            
            // Ре-инициализация наблюдателя за появлением элементов
            initScrollAnimations();
        }


        // --- СТАРЫЕ ФУНКЦИИ АДМИНКИ И ГАЛЕРЕИ (с поддержкой вкладок) ---
        function switchAdminTab(tabId) {
            document.querySelectorAll('.admin-tab-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.admin-tab-btn').forEach(el => {
                el.classList.remove('border-black', 'text-black');
                el.classList.add('border-transparent', 'text-mutedText');
            });
            
            document.getElementById(tabId).classList.remove('hidden');
            const activeBtn = Array.from(document.querySelectorAll('.admin-tab-btn')).find(b => b.getAttribute('onclick').includes(tabId));
            if(activeBtn) {
                activeBtn.classList.remove('border-transparent', 'text-mutedText');
                activeBtn.classList.add('border-black', 'text-black');
            }
        }

        async function handleFileUpload(event) {
            if (!event.target.files.length) return;
            await processFilesForUpload(event.target.files, (data, name) => { SITE_PHOTOS.siteItems.push({ src: data, alt: name }); });
            await idb.set('abkhazia_site_slides', SITE_PHOTOS.siteItems);
            updateMorphGallery(); renderAdminMediaLists();
        }

        async function handleGalleryUpload(event) {
            if (!event.target.files.length) return;
            await processFilesForUpload(event.target.files, (data) => { SITE_PHOTOS.galleryItems.push({ src: data }); });
            await idb.set('abkhazia_gallery_photos', SITE_PHOTOS.galleryItems);
            renderVortexGallery(); renderAdminMediaLists();
        }

        function deleteAdminItem(listName, idx, storageKey, renderFunc) {
            SITE_PHOTOS[listName].splice(idx, 1);
            idb.set(storageKey, SITE_PHOTOS[listName]).then(() => { renderFunc(); renderAdminMediaLists(); });
        }

        function renderAdminMediaLists() {
            const createListHTML = (list, name, key, rFunc) => list.map((item, idx) => `
                <div class="relative group rounded-lg overflow-hidden h-24 border border-borderLight bg-siteBg">
                    <img src="${item.src}" class="w-full h-full object-cover">
                    <button onclick="deleteAdminItem('${name}', ${idx}, '${key}', ${rFunc.name})" class="absolute top-1 right-1 w-6 h-6 rounded-full bg-white text-darkText flex items-center justify-center hover:bg-red-500 hover:text-white transition-all shadow-md">
                        <i class="fa-solid fa-trash text-[10px]"></i>
                    </button>
                </div>`).join('');

            document.getElementById('adminCarouselList').innerHTML = createListHTML(SITE_PHOTOS.siteItems, 'siteItems', 'abkhazia_site_slides', updateMorphGallery);
            document.getElementById('adminGalleryList').innerHTML = createListHTML(SITE_PHOTOS.galleryItems, 'galleryItems', 'abkhazia_gallery_photos', renderVortexGallery);
            renderAdminLiveFeed();
        }

        function renderAdminLiveFeed() {
            const container = document.getElementById('adminLiveFeedList');
            if(!container) return;
            container.innerHTML = LIVE_FEED_DATA.map(item => `
                <div class="relative group rounded-lg overflow-hidden h-24 border border-borderLight bg-black">
                    ${item.type === 'video' 
                        ? `<video src="${item.src}" class="w-full h-full object-cover opacity-70"></video><i class="fa-solid fa-video absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-white"></i>` 
                        : `<img src="${item.src}" class="w-full h-full object-cover">`}
                    <button onclick="deleteLiveFeedItem('${item.id}')" class="absolute top-1 right-1 w-6 h-6 rounded-full bg-white text-darkText flex items-center justify-center hover:bg-red-500 hover:text-white transition-all shadow-md z-10">
                        <i class="fa-solid fa-trash text-[10px]"></i>
                    </button>
                </div>
            `).join('');
        }

        function toggleAdminModal() {
            const modal = document.getElementById('adminModal');
            if (modal.classList.contains('hidden')) {
                renderAdminMediaLists(); modal.classList.remove('hidden'); setTimeout(() => modal.classList.remove('opacity-0'), 10);
            } else {
                modal.classList.add('opacity-0'); setTimeout(() => modal.classList.add('hidden'), 300);
            }
        }

        // Маршруты и 3D галерея (сохранены из оригинального кода)
        const initialSochiRoutes = [ { id: 's1', destination: 'Гагра', price: '5 000 руб.' }, { id: 's2', destination: 'Пицунда', price: '6 000 руб.' }, { id: 's3', destination: 'Гудаута', price: '6 500 руб.' }, { id: 's4', destination: 'Новый Афон', price: '7 000 руб.' }, { id: 's5', destination: 'Сухум', price: '8 000 руб.' } ];
        const initialSukhumRoutes = [ { id: 'k1', destination: 'Сухум', price: '3 500 руб.' }, { id: 'k2', destination: 'Новый Афон', price: '4 500 руб.' }, { id: 'k3', destination: 'Гудаута', price: '5 500 руб.' }, { id: 'k4', destination: 'Пицунда', price: '6 500 руб.' }, { id: 'k5', destination: 'Гагра', price: '7 500 руб.' } ];
        const initialTours = [ { id: 't1', route: 'Сухум - Новый Афон - оз. Рица - Гагра', price: '20 000 руб.' }, { id: 't2', route: 'Новый Афон - оз. Рица - Гагра', price: '15 000 руб.' }, { id: 't3', route: 'Гагра - оз. Рица', price: '10 000 руб.' }, { id: 't4', route: 'Гагра - Новый Афон - оз. Рица', price: '15 000 руб.' }, { id: 't5', route: 'Сухум - Ткуарчал - Черниговка', price: '15 000 - 17 000 руб.' } ];

        function renderRoutes() {
            const createTransferHTML = (item, prefix) => `<div onclick="openRouteModal('${prefix} ${item.destination}', '${item.price}', '${item.id}')" class="clean-card p-5 flex items-center justify-between cursor-pointer group"><span class="font-weight-body text-darkText">${item.destination}</span><div class="flex items-center space-x-3"><span class="font-weight-heading text-darkText text-lg">${item.price}</span><i class="fa-solid fa-arrow-right text-sm text-borderLight group-hover:text-darkText transition-all transform group-hover:translate-x-1"></i></div></div>`;
            document.getElementById('sochiRoutes').innerHTML = initialSochiRoutes.map(i => createTransferHTML(i, 'Из Сочи в')).join('');
            document.getElementById('sukhumRoutes').innerHTML = initialSukhumRoutes.map(i => createTransferHTML(i, 'Из Сухума в')).join('');
            document.getElementById('toursList').innerHTML = initialTours.map((item, idx) => `<div onclick="openRouteModal('Экскурсия: ${item.route}', '${item.price}', '${item.id}')" class="clean-card p-8 cursor-pointer flex flex-col justify-between group reveal-element ${idx % 2 === 0 ? 'delay-100' : ''}"><div><div class="flex items-center justify-between mb-8"><span class="text-xs uppercase tracking-widest text-mutedText font-medium">Тур</span><i class="fa-solid fa-arrow-up-right-from-square text-borderLight group-hover:text-darkText transition-colors"></i></div><h3 class="text-xl font-medium text-darkText mb-12 leading-snug">${item.route}</h3></div><div class="pt-6 border-t border-borderLight/40 flex items-center justify-between mt-auto"><span class="text-darkText font-medium text-lg">${item.price}</span></div></div>`).join('');
        }

        // Лайтбокс и инициализация
        function openLightbox(url) {
            const modal = document.getElementById('lightboxModal'), img = document.getElementById('lightboxImg');
            img.src = url; modal.classList.remove('hidden');
            setTimeout(() => { modal.classList.remove('opacity-0'); img.classList.replace('scale-95', 'scale-100'); }, 10);
        }
        function closeLightbox() {
            const modal = document.getElementById('lightboxModal'), img = document.getElementById('lightboxImg');
            modal.classList.add('opacity-0'); img.classList.replace('scale-100', 'scale-95');
            setTimeout(() => modal.classList.add('hidden'), 300);
        }

        let activeRouteId = null;
        function openRouteModal(title, price, routeId) { activeRouteId = routeId; document.getElementById('modalTitle').innerText = title; document.getElementById('modalPrice').innerText = price; renderRouteModalPhotos(); const m = document.getElementById('routeModal'); m.classList.remove('hidden'); setTimeout(()=>m.classList.remove('opacity-0'),10); }
        function closeRouteModal() { const m = document.getElementById('routeModal'); m.classList.add('opacity-0'); setTimeout(()=>m.classList.add('hidden'),300); }
        async function uploadRoutePhotos(e) { if(!e.target.files.length||!activeRouteId)return; if(!routePhotos[activeRouteId]) routePhotos[activeRouteId]=[]; await processFilesForUpload(e.target.files, (data)=>{routePhotos[activeRouteId].push(data);}); await idb.set('abkhazia_route_photos', routePhotos); renderRouteModalPhotos(); renderVortexGallery(); }
        function renderRouteModalPhotos() { const gal = document.getElementById('modalGallery'); const p = routePhotos[activeRouteId]||[]; if(!p.length){ gal.innerHTML=`<div class="w-full text-center py-16 text-mutedText border border-dashed rounded-xl">Фотографий нет</div>`; } else { gal.innerHTML=p.map((url,idx)=>`<div class="relative group min-w-[70%] md:min-w-[50%] h-full snap-center rounded-xl overflow-hidden shrink-0"><img src="${url}" onclick="openLightbox('${url}')" class="w-full h-full object-cover cursor-pointer hover:scale-105 transition-transform enhanced-img"><button onclick="deleteRoutePhoto(${idx})" class="absolute top-4 right-4 w-10 h-10 rounded-full bg-white text-darkText opacity-0 group-hover:opacity-100 hover:bg-red-500 hover:text-white transition-all shadow-lg"><i class="fa-solid fa-trash"></i></button></div>`).join(''); } }
        async function deleteRoutePhoto(idx) { routePhotos[activeRouteId].splice(idx,1); await idb.set('abkhazia_route_photos', routePhotos); renderRouteModalPhotos(); renderVortexGallery(); }

        let vortexAngle = 0, isDraggingVortex = false, startX = 0;
        function renderVortexGallery() {
            const container = document.getElementById('vortexCarousel');
            if (!container) return;
            const images = Array.from(new Set([...SITE_PHOTOS.galleryItems.map(s=>s.src), ...Object.values(routePhotos).flat()]));
            if(images.length === 0) images.push('https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=800&q=80');
            const total = images.length, radius = Math.max(340, window.innerWidth * 0.4), angleStep = 360 / Math.max(total, 1);
            container.innerHTML = images.map((url, idx) => `<div class="vortex-card" style="transform: rotateY(${idx * angleStep}deg) translateZ(${radius}px);" onclick="openLightbox('${url}')"><img src="${url}" class="w-full h-full object-cover pointer-events-none enhanced-img"></div>`).join('');
            updateVortexTransform();
        }
        function updateVortexTransform() { document.getElementById('vortexCarousel').style.transform = `rotateY(${vortexAngle}deg)`; }
        function rotateVortex(dir) { vortexAngle += dir * 40; updateVortexTransform(); }
        function initVortexInteractions() { const stage = document.querySelector('.vortex-stage'); if(!stage)return; const startDrag=e=>{isDraggingVortex=true;startX=e.clientX||e.touches[0].clientX;}; const moveDrag=e=>{if(!isDraggingVortex)return; vortexAngle+=((e.clientX||e.touches[0].clientX)-startX)*0.5; startX=e.clientX||e.touches[0].clientX; updateVortexTransform();}; const stopDrag=()=>isDraggingVortex=false; stage.addEventListener('mousedown',startDrag); window.addEventListener('mousemove',moveDrag); window.addEventListener('mouseup',stopDrag); stage.addEventListener('touchstart',startDrag,{passive:true}); stage.addEventListener('touchmove',moveDrag,{passive:true}); stage.addEventListener('touchend',stopDrag); }
        function updateMorphGallery() { if(window.renderReactMorphGallery) window.renderReactMorphGallery(SITE_PHOTOS.siteItems); }

        function initScrollAnimations() {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => { if (entry.isIntersecting) entry.target.classList.add('active'); });
            }, { root: null, threshold: 0.1 });
            document.querySelectorAll('.reveal-element').forEach(el => observer.observe(el));
        }

        window.addEventListener('DOMContentLoaded', async () => {
            try {
                // Загружаем сохраненные данные
                const sSlides = await idb.get('abkhazia_site_slides'); if (sSlides?.length) SITE_PHOTOS.siteItems = sSlides;
                const sGallery = await idb.get('abkhazia_gallery_photos'); if (sGallery?.length) SITE_PHOTOS.galleryItems = sGallery;
                const sRoutes = await idb.get('abkhazia_route_photos'); if (sRoutes) routePhotos = sRoutes;
                const sCars = await idb.get('abkhazia_cars_data'); if (sCars) CARS_DATA = sCars;
                const sLive = await idb.get('abkhazia_live_feed'); if (sLive) LIVE_FEED_DATA = sLive;
            } catch(e) { console.error("DB Load Error", e); }

            renderRoutes();
            setTimeout(() => {
                updateMorphGallery(); 
                renderCarShowcaseSlider();
                renderCarsList();
                renderLiveFeed();
                renderVortexGallery();
                initVortexInteractions(); 
                initScrollAnimations();
            }, 150);
        });
        window.addEventListener('resize', renderVortexGallery);
    </script>
</body>
</html>
