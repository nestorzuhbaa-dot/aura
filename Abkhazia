<!DOCTYPE html>
<html lang="ru" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Трансфер и Экскурсии по Абхазии | Premium Travel</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,300;0,400;0,500;0,600;1,300&display=swap" rel="stylesheet">
    
    <!-- React & ReactDOM CDN for MorphGallery WebGL component -->
    <script crossorigin src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        siteBg: '#e9e9e4',
                        cardBg: '#ffffff',
                        darkText: '#111111',
                        mutedText: '#666666',
                        borderLight: '#d5d5d0',
                        accentBlack: '#000000',
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                }
            }
        }
    </script>

    <style>
        body {
            background-color: theme('colors.siteBg');
            color: theme('colors.darkText');
            font-family: 'Inter', sans-serif;
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
        }

        .font-weight-display { font-weight: 500; letter-spacing: -0.04em; line-height: 1.05; }
        .font-weight-heading { font-weight: 500; letter-spacing: -0.01em; line-height: 1.2; }
        .font-weight-body { font-weight: 400; line-height: 1.6; }
        
        .mercury-header {
            background-color: #e9e9e4;
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        }

        .hero-section { background-color: #000; color: #fff; }

        .clean-card {
            background-color: #fff;
            border-radius: 8px;
            border: 1px solid rgba(0,0,0,0.04);
            box-shadow: 0 4px 20px rgba(0,0,0,0.02);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .clean-card:hover { transform: translateY(-4px); box-shadow: 0 12px 30px rgba(0,0,0,0.06); }

        .btn-white { background-color: #fff; color: #000; border-radius: 40px; transition: background-color 0.3s ease; }
        .btn-white:hover { background-color: #f0f0f0; }
        .btn-outline-white { background-color: transparent; border: 1px solid #fff; color: #fff; border-radius: 40px; transition: all 0.3s ease; }
        .btn-outline-white:hover { background-color: #fff; color: #000; }
        
        .btn-outline-dark { background-color: transparent; border: 1px solid #111; color: #111; border-radius: 40px; transition: all 0.3s ease; }
        .btn-outline-dark:hover { background-color: #111; color: #fff; }

        .reveal-element { opacity: 0; transform: translateY(40px); transition: all 0.9s cubic-bezier(0.16, 1, 0.3, 1); }
        .reveal-element.active { opacity: 1; transform: translateY(0); }
        .delay-100 { transition-delay: 100ms; }
        .delay-200 { transition-delay: 200ms; }

        .vortex-stage { perspective: 1200px; perspective-origin: 50% 50%; user-select: none; touch-action: pan-y; }
        .vortex-carousel { position: relative; width: 100%; height: 100%; transform-style: preserve-3d; transition: transform 0.1s linear; }
        .vortex-card {
            position: absolute; left: 50%; top: 50%; width: 260px; height: 360px; margin-left: -130px; margin-top: -180px;
            border-radius: 12px; overflow: hidden; background-color: #fff; cursor: pointer; backface-visibility: visible;
            box-shadow: 0 20px 40px rgba(0,0,0,0.15); transition: transform 0.3s ease;
        }
        @media (min-width: 640px) { .vortex-card { width: 320px; height: 440px; margin-left: -160px; margin-top: -220px; } }
        
        .enhanced-img { filter: contrast(1.08) saturate(1.15) brightness(1.02); image-rendering: high-quality; transform: translateZ(0); }

        .swipe-container { scrollbar-width: none; -ms-overflow-style: none; }
        .swipe-container::-webkit-scrollbar { display: none; }
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #ccc; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #999; }

        /* Smooth Expanding Section */
        .expandable-container {
            display: grid;
            grid-template-rows: 0fr;
            transition: grid-template-rows 0.7s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .expandable-container.expanded {
            grid-template-rows: 1fr;
        }
        .expandable-inner {
            overflow: hidden;
        }
        
        /* Auto-resize textarea */
        textarea.auto-resize {
            resize: none;
            overflow: hidden;
            min-height: 40px;
        }
    </style>
</head>
<body class="relative">

    <header class="fixed top-0 left-0 right-0 z-50 mercury-header px-4 sm:px-8 py-4">
        <div class="max-w-[1400px] mx-auto flex items-center justify-between">
            <a href="#" class="flex items-center space-x-2 group">
                <i class="fa-solid fa-layer-group text-lg text-darkText"></i>
                <span class="text-xl font-weight-heading tracking-tight text-darkText">Abkhazia</span>
            </a>
            
            <nav class="hidden md:flex items-center space-x-8 text-sm text-mutedText font-medium tracking-wide">
                <a href="#services" class="hover:text-darkText transition-colors duration-300">Услуги</a>
                <a href="#transfers" class="hover:text-darkText transition-colors duration-300">Трансфер</a>
                <a href="#cars" class="hover:text-darkText transition-colors duration-300">Автопарк</a>
                <a href="#live-feed" class="hover:text-darkText transition-colors duration-300">Live</a>
                <a href="#tours" class="hover:text-darkText transition-colors duration-300">Экскурсии</a>
                <a href="#vortex-gallery" class="hover:text-darkText transition-colors duration-300">Галерея</a>
            </nav>

            <div class="flex items-center space-x-6 text-sm font-medium">
                <button onclick="toggleAdminModal()" class="text-mutedText hover:text-darkText transition-colors hidden sm:block">
                    Админка
                </button>
                <a href="#contacts" class="text-darkText hover:opacity-70 transition-opacity">
                    Контакты
                </a>
            </div>
        </div>
    </header>

    <section class="hero-section relative w-full h-[100svh] min-h-[600px] flex items-center overflow-hidden pt-16">
        <div class="absolute inset-0 z-0">
            <div id="morphGalleryRoot" class="w-full h-full"></div>
            <div class="absolute inset-0 bg-gradient-to-r from-black/90 via-black/60 to-black/30 z-10 pointer-events-none"></div>
        </div>
        <div class="relative z-20 max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 w-full mt-10">
            <div class="max-w-4xl reveal-element">
                <h1 class="text-6xl sm:text-7xl md:text-8xl lg:text-[100px] font-weight-display tracking-tighter leading-[0.95] text-white">
                    Путешествуйте <br>
                    <span class="font-light italic text-white/90">с Удовольствием</span>
                </h1>
                <p class="mt-8 text-white/80 text-lg md:text-xl max-w-2xl font-weight-body leading-relaxed">
                    Индивидуальный подход. Экскурсии по всей Абхазии, трансфер из аэропортов Сочи и Сухума.
                </p>
                <div class="flex flex-wrap gap-4 mt-12">
                    <a href="https://wa.me/79409368390" target="_blank" class="btn-white px-8 py-4 text-sm font-medium flex items-center space-x-2">
                        <i class="fa-brands fa-whatsapp text-lg"></i>
                        <span>WhatsApp</span>
                    </a>
                    <a href="#tours" class="btn-outline-white px-8 py-4 text-sm font-medium">
                        Наши маршруты
                    </a>
                </div>
            </div>
        </div>
    </section>

    <section id="services" class="py-24 relative z-10 border-t border-borderLight/30">
        <!-- Содержимое услуг без изменений -->
        <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8">
            <div class="mb-16 reveal-element">
                <h2 class="text-4xl md:text-5xl font-weight-display text-darkText">Услуги и Преимущества</h2>
                <p class="text-mutedText mt-4 text-lg font-weight-body max-w-3xl">Всё для вашего идеального, стильного и безопасного путешествия по Абхазии.</p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
                <div class="clean-card p-10 reveal-element">
                    <div class="text-3xl text-darkText mb-6"><i class="fa-solid fa-map-location-dot"></i></div>
                    <h3 class="text-xl font-weight-heading text-darkText mb-3">Экскурсии</h3>
                    <p class="text-mutedText font-weight-body">Увлекательные туры и персонализированные автомаршруты по всем живописным уголкам Абхазии.</p>
                </div>
                <div class="clean-card p-10 reveal-element delay-100">
                    <div class="text-3xl text-darkText mb-6"><i class="fa-solid fa-van-shuttle"></i></div>
                    <h3 class="text-xl font-weight-heading text-darkText mb-3">Трансфер</h3>
                    <p class="text-mutedText font-weight-body">Встреча из аэропортов Сочи и Сухума, подача вовремя в любую точку Страны Души.</p>
                </div>
                <div class="clean-card p-10 reveal-element delay-200">
                    <div class="text-3xl text-darkText mb-6"><i class="fa-solid fa-people-group"></i></div>
                    <h3 class="text-xl font-weight-heading text-darkText mb-3">Мероприятия</h3>
                    <p class="text-mutedText font-weight-body">Обслуживание свадеб, торжеств, VIP-делегаций и корпоративных поездок на высшем уровне.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- АВТОПАРК СО СПИСКОМ -->
    <section id="cars" class="py-24 relative z-10 border-t border-borderLight/30 overflow-hidden bg-white">
        <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 flex flex-col items-center">
            
            <div class="w-full flex flex-col lg:flex-row items-center gap-12 lg:gap-20 mb-12">
                <div class="w-full lg:w-1/2 reveal-element">
                    <h2 class="text-4xl md:text-5xl font-weight-display text-darkText mb-6">Наши Машины</h2>
                    <p class="text-mutedText text-lg font-weight-body mb-8 leading-relaxed">
                        Мы предоставляем только современные и надежные автомобили. Нажмите на фото или кнопку ниже, чтобы раскрыть весь список автомобилей, посмотреть фотографии и прочитать детальное описание.
                    </p>
                    <button onclick="toggleCarsList()" class="btn-outline-dark px-8 py-3 text-sm font-medium flex items-center space-x-2">
                        <span>Показать весь автопарк</span>
                        <i id="carsChevron" class="fa-solid fa-chevron-down transition-transform duration-300"></i>
                    </button>
                </div>

                <!-- Зона плавной смены фотографий (Слайдер), кликабельная -->
                <div onclick="toggleCarsList()" class="w-full lg:w-1/2 h-[400px] md:h-[450px] relative rounded-2xl overflow-hidden reveal-element delay-100 shadow-2xl bg-siteBg border border-borderLight cursor-pointer group" id="carShowcaseContainer">
                    <!-- Генерируется через JS -->
                    <div class="absolute inset-0 bg-black/10 group-hover:bg-black/0 transition-colors z-20"></div>
                </div>
            </div>

            <!-- РАСКРЫВАЮЩИЙСЯ СПИСОК МАШИН -->
            <div id="carsExpandedWrapper" class="expandable-container w-full">
                <div class="expandable-inner">
                    <div class="w-full border-t border-borderLight/50 pt-12 pb-6">
                        <div class="flex justify-between items-center mb-8">
                            <h3 class="text-2xl font-weight-heading text-darkText">Список автомобилей</h3>
                            <button onclick="addNewCar()" class="text-sm font-medium text-darkText bg-siteBg hover:bg-gray-200 px-5 py-2.5 rounded-full transition-colors flex items-center space-x-2 border border-borderLight">
                                <i class="fa-solid fa-plus"></i> <span>Добавить машину</span>
                            </button>
                        </div>
                        
                        <div id="carsListContainer" class="flex flex-col gap-10">
                            <!-- Контент машин рендерится здесь -->
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </section>

    <!-- НОВЫЙ РАЗДЕЛ: ЖИВЫЕ МОМЕНТЫ (ВИДЕО/ФОТО) -->
    <section id="live-feed" class="py-24 relative z-10 border-t border-borderLight/30 bg-siteBg overflow-hidden">
        <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8">
            <div class="mb-16 reveal-element text-center">
                <h2 class="text-4xl md:text-5xl font-weight-display text-darkText">Живые моменты</h2>
                <p class="text-mutedText mt-4 text-lg font-weight-body">Атмосфера наших поездок. Фотографии и видео из Абхазии.</p>
            </div>
            
            <div id="liveFeedGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 auto-rows-max">
                <!-- Контент живой ленты генерируется через JS -->
            </div>
        </div>
    </section>

    <!-- Остальные секции (Трансфер, Экскурсии, Галерея, Контакты) -->
    <section id="transfers" class="py-24 relative z-10 border-t border-borderLight/30 bg-white">
        <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8">
            <div class="mb-16 reveal-element">
                <h2 class="text-4xl md:text-5xl font-weight-display text-darkText">Стоимость Поездок</h2>
                <p class="text-mutedText mt-4 text-lg font-weight-body max-w-3xl">Нажмите на маршрут, чтобы посмотреть фотографии и забронировать.</p>
            </div>
            <div class="grid lg:grid-cols-2 gap-12">
                <div class="reveal-element">
                    <div class="flex items-center space-x-4 mb-8">
                        <div class="w-12 h-12 rounded-full bg-siteBg border border-borderLight flex items-center justify-center text-darkText text-xl">
                            <i class="fa-solid fa-plane-arrival"></i>
                        </div>
                        <h3 class="text-2xl font-weight-heading text-darkText">Из аэропорта Сочи</h3>
                    </div>
                    <div id="sochiRoutes" class="space-y-3"></div>
                </div>
                <div class="reveal-element delay-100">
                    <div class="flex items-center space-x-4 mb-8">
                        <div class="w-12 h-12 rounded-full bg-siteBg border border-borderLight flex items-center justify-center text-darkText text-xl">
                            <i class="fa-solid fa-plane-arrival"></i>
                        </div>
                        <h3 class="text-2xl font-weight-heading text-darkText">Из аэропорта Сухума</h3>
                    </div>
                    <div id="sukhumRoutes" class="space-y-3"></div>
                </div>
            </div>
        </div>
    </section>

    <section id="tours" class="py-24 relative z-10 border-t border-borderLight/30 bg-[#f4f3ef]">
        <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8">
            <div class="mb-12 reveal-element">
                <h2 class="text-4xl md:text-5xl font-weight-display text-darkText">Экскурсии</h2>
            </div>
            <div id="toursList" class="grid md:grid-cols-2 lg:grid-cols-3 gap-6"></div>
        </div>
    </section>

    <section id="vortex-gallery" class="py-24 relative z-10 overflow-hidden bg-siteBg border-t border-borderLight/30">
        <div class="w-full flex justify-center mb-16 reveal-element">
            <h2 class="text-5xl sm:text-6xl md:text-7xl font-weight-display text-darkText tracking-tight text-center">Галерея</h2>
        </div>
        <div class="vortex-stage h-[500px] sm:h-[600px] relative flex items-center justify-center reveal-element delay-100">
            <div id="vortexCarousel" class="vortex-carousel"></div>
            <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-30 flex items-center space-x-6 bg-white/70 backdrop-blur-md border border-borderLight px-8 py-3 rounded-pill shadow-lg">
                <button onclick="rotateVortex(-1)" class="text-darkText hover:text-mutedText transition-colors"><i class="fa-solid fa-arrow-left"></i></button>
                <span class="text-xs uppercase text-darkText tracking-widest font-semibold">Свайпайте</span>
                <button onclick="rotateVortex(1)" class="text-darkText hover:text-mutedText transition-colors"><i class="fa-solid fa-arrow-right"></i></button>
            </div>
        </div>
    </section>

    <section id="contacts" class="py-24 relative z-10 border-t border-borderLight/30 bg-white">
        <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 reveal-element">
            <div class="bg-siteBg rounded-xl border border-borderLight p-10 sm:p-16 text-center max-w-4xl mx-auto shadow-sm">
                <h2 class="text-4xl md:text-5xl font-weight-display text-darkText">Забронировать Поездку</h2>
                <div class="flex flex-wrap justify-center gap-4 mt-12">
                    <a href="https://wa.me/79409368390" class="bg-black text-white px-8 py-4 rounded-full text-sm font-medium flex items-center space-x-2">
                        <i class="fa-brands fa-whatsapp"></i><span>WhatsApp</span>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <footer class="py-10 text-center text-sm text-mutedText border-t border-borderLight/30">
        <p>© 2026 Трансфер и Экскурсии по Абхазии | Страна Души.</p>
    </footer>

    <!-- Модальные окна (Маршруты, Лайтбокс) -->
    <div id="routeModal" class="fixed inset-0 z-[100] bg-siteBg/90 backdrop-blur-md hidden flex items-center justify-center p-4 transition-all duration-300 opacity-0">
        <div class="bg-white max-w-5xl w-full p-8 rounded-xl border border-borderLight shadow-2xl max-h-[90vh] flex flex-col relative">
            <button onclick="closeRouteModal()" class="absolute top-6 right-6 w-10 h-10 rounded-full bg-siteBg hover:bg-gray-200 flex items-center justify-center z-10">
                <i class="fa-solid fa-xmark"></i>
            </button>
            <div class="mb-6 shrink-0"><h3 id="modalTitle" class="text-3xl font-weight-heading text-darkText"></h3><p id="modalPrice" class="text-xl text-mutedText mt-2"></p></div>
            <div class="flex-1 overflow-y-auto relative flex flex-col">
                <div class="flex items-center justify-between mb-4"><h4 class="text-sm font-medium uppercase">Фотографии</h4>
                    <label class="cursor-pointer border px-5 py-2.5 rounded-full text-sm hover:bg-siteBg flex items-center space-x-2">
                        <i class="fa-solid fa-plus"></i><span>Добавить</span><input type="file" accept="image/*" multiple class="hidden" onchange="uploadRoutePhotos(event)">
                    </label>
                </div>
                <div id="modalGallery" class="flex overflow-x-auto gap-4 pb-4 snap-x snap-mandatory swipe-container h-64 md:h-[400px]"></div>
            </div>
        </div>
    </div>

    <div id="lightboxModal" class="fixed inset-0 z-[110] bg-black/95 hidden flex items-center justify-center p-4 transition-all duration-300 opacity-0" onclick="closeLightbox()">
        <img id="lightboxImg" class="max-w-full max-h-[90vh] object-contain scale-95 transition-transform duration-300" src="">
    </div>

    <!-- ОБНОВЛЕННАЯ АДМИН-ПАНЕЛЬ С ВКЛАДКАМИ -->
    <div id="adminModal" class="fixed inset-0 z-[100] bg-siteBg/95 backdrop-blur-md hidden flex items-center justify-center p-4 transition-all duration-300 opacity-0">
        <div class="bg-white max-w-6xl w-full p-8 rounded-xl border border-borderLight shadow-xl flex flex-col h-[90vh] relative">
            
            <div class="flex justify-between items-center border-b border-borderLight/50 pb-6 mb-6 shrink-0">
                <h3 class="text-2xl font-weight-heading text-darkText flex items-center space-x-3">
                    <i class="fa-solid fa-sliders text-mutedText"></i><span>Управление контентом</span>
                </h3>
                <button onclick="toggleAdminModal()" class="w-10 h-10 rounded-full bg-siteBg hover:bg-gray-200 flex items-center justify-center">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <!-- Вкладки админки -->
            <div class="flex space-x-4 mb-6 border-b border-borderLight/50 pb-2 overflow-x-auto swipe-container shrink-0">
                <button onclick="switchAdminTab('tab-main')" class="admin-tab-btn active px-4 py-2 text-sm font-medium border-b-2 border-black text-black">Главный Фон</button>
                <button onclick="switchAdminTab('tab-gallery')" class="admin-tab-btn px-4 py-2 text-sm font-medium border-b-2 border-transparent text-mutedText hover:text-black">3D Галерея</button>
                <button onclick="switchAdminTab('tab-live')" class="admin-tab-btn px-4 py-2 text-sm font-medium border-b-2 border-transparent text-mutedText hover:text-black">Живая Лента (Live)</button>
            </div>

            <div class="flex-1 overflow-y-auto pr-2 custom-scrollbar">
                
                <!-- Таб: Главный фон -->
                <div id="tab-main" class="admin-tab-content space-y-6">
                    <div class="bg-siteBg p-6 rounded-xl border border-borderLight">
                        <h4 class="font-medium text-darkText mb-4">Фото для анимации фона (Hero)</h4>
                        <label class="inline-block border border-dashed border-darkText px-6 py-3 rounded-full cursor-pointer hover:bg-gray-100 transition-colors">
                            <i class="fa-solid fa-upload mr-2"></i> Загрузить фото
                            <input type="file" accept="image/*" multiple class="hidden" onchange="handleFileUpload(event)">
                        </label>
                        <div id="adminCarouselList" class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-6"></div>
                    </div>
                </div>

                <!-- Таб: 3D Галерея -->
                <div id="tab-gallery" class="admin-tab-content hidden space-y-6">
                    <div class="bg-siteBg p-6 rounded-xl border border-borderLight">
                        <h4 class="font-medium text-darkText mb-4">Фотографии для 3D Галереи-Карусели</h4>
                        <label class="inline-block border border-dashed border-darkText px-6 py-3 rounded-full cursor-pointer hover:bg-gray-100 transition-colors">
                            <i class="fa-solid fa-images mr-2"></i> Добавить в галерею
