        // Пустые массивы для пользовательского контента
        let CARS_DATA = []; // { id, title, description, photos: [] }
        let LIVE_FEED_DATA = []; // { id, type: 'image'|'video', src }
        let routePhotos = {};
        
        // --- Утилиты сжатия ---
        function compressImage(base64Str, maxWidth = 1920, quality = 0.85) {
            return new Promise((resolve) => {
                const img = new Image();
                img.src = base64Str;
                img.onload = () => {
                    const canvas = document.createElement('canvas');
                    let width = img.width; let height = img.height;
                    if (width > maxWidth) { height = Math.round((height * maxWidth) / width); width = maxWidth; }
                    canvas.width = width; canvas.height = height;
                    const ctx = canvas.getContext('2d');
                    ctx.drawImage(img, 0, 0, width, height);
                    resolve(canvas.toDataURL('image/jpeg', quality));
                };
            });
        }

        async function processFilesForUpload(files, callback, asIsForVideo = false) {
            for (let i = 0; i < files.length; i++) {
                const file = files[i];
                const reader = new FileReader();
                const rawData = await new Promise(res => { reader.onload = e => res(e.target.result); reader.readAsDataURL(file); });
                
                if (file.type.startsWith('video') && asIsForVideo) {
                    callback(rawData, file.name, 'video');
                } else if (file.type.startsWith('image')) {
                    const compressedData = await compressImage(rawData, 1920, 0.85);
                    callback(compressedData, file.name, 'image');
                }
            }
        }

        // --- ЛОГИКА АВТОПАРКА (Новая) ---
        let carsListExpanded = false;

        function toggleCarsList() {
            carsListExpanded = !carsListExpanded;
            const wrapper = document.getElementById('carsExpandedWrapper');
            const chevron = document.getElementById('carsChevron');
            if (carsListExpanded) {
                wrapper.classList.add('expanded');
                if(chevron) chevron.classList.add('rotate-180');
                renderCarsList();
            } else {
                wrapper.classList.remove('expanded');
                if(chevron) chevron.classList.remove('rotate-180');
            }
        }

        async function saveCarsData() {
            await idb.set('abkhazia_cars_data', CARS_DATA);
            renderCarShowcaseSlider();
        }

        function addNewCar() {
            const title = prompt("Введите название автомобиля (например, Mercedes S-Class):");
            if (!title) return;
            CARS_DATA.push({
                id: 'car_' + Date.now(),
                title: title,
                description: '',
                photos: []
            });
            saveCarsData();
            renderCarsList();
        }

        function deleteCar(carId) {
            if(!confirm("Удалить этот автомобиль полностью?")) return;
            CARS_DATA = CARS_DATA.filter(c => c.id !== carId);
            saveCarsData();
            renderCarsList();
        }

        async function handleCarPhotoUpload(event, carId) {
            if (!event.target.files.length) return;
            const car = CARS_DATA.find(c => c.id === carId);
            if(!car) return;
            
            await processFilesForUpload(event.target.files, (data) => {
                car.photos.push(data);
            });
            await saveCarsData();
            renderCarsList();
        }

        function deleteCarPhoto(carId, photoIdx) {
            const car = CARS_DATA.find(c => c.id === carId);
            if(car) {
                car.photos.splice(photoIdx, 1);
                saveCarsData();
                renderCarsList();
            }
        }

        function updateCarDescription(carId, el) {
            const car = CARS_DATA.find(c => c.id === carId);
            if(car) {
                car.description = el.value;
                saveCarsData();
            }
            // Авто-ресайз текстареа
            el.style.height = 'auto';
            el.style.height = (el.scrollHeight) + 'px';
        }

        function renderCarsList() {
            const container = document.getElementById('carsListContainer');
            if(!container) return;

            if(CARS_DATA.length === 0) {
                container.innerHTML = `<p class="text-mutedText text-center py-8">Список машин пуст. Нажмите «Добавить машину».</p>`;
                return;
            }

            container.innerHTML = CARS_DATA.map(car => `
                <div class="bg-siteBg rounded-2xl border border-borderLight overflow-hidden flex flex-col transition-all duration-500 ease-in-out hover:shadow-lg">
                    <div class="p-6 border-b border-borderLight/50 flex justify-between items-center bg-white">
                        <h4 class="text-2xl font-weight-heading text-darkText">${car.title}</h4>
                        <button onclick="deleteCar('${car.id}')" class="text-mutedText hover:text-red-500 transition-colors w-10 h-10 flex items-center justify-center rounded-full hover:bg-red-50">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </div>
                    
                    <div class="p-6">
                        <!-- Галерея фото конкретной машины -->
                        <div class="flex overflow-x-auto gap-4 pb-4 snap-x swipe-container h-48 md:h-64 mb-6">
                            ${car.photos.map((p, idx) => `
                                <div class="relative group min-w-[200px] md:min-w-[300px] h-full rounded-xl overflow-hidden snap-center shrink-0 border border-borderLight">
                                    <img src="${p}" onclick="openLightbox('${p}')" class="w-full h-full object-cover cursor-pointer hover:scale-105 transition-transform duration-500 enhanced-img">
                                    <button onclick="deleteCarPhoto('${car.id}',${idx})" class="absolute top-2 right-2 w-8 h-8 rounded-full bg-white text-darkText flex items-center justify-center opacity-0 group-hover:opacity-100 hover:bg-red-500 hover:text-white transition-all shadow-md z-10">
                                        <i class="fa-solid fa-xmark"></i>
                                    </button>
                                </div>
                            `).join('')}
                            
                            <!-- Кнопка добавления фото -->
                            <label class="min-w-[200px] md:min-w-[300px] h-full rounded-xl border-2 border-dashed border-borderLight hover:border-darkText flex flex-col items-center justify-center cursor-pointer transition-colors snap-center shrink-0 bg-white/50 group">
                                <i class="fa-solid fa-plus text-3xl text-borderLight group-hover:text-darkText transition-colors mb-2"></i>
                                <span class="text-sm font-medium text-mutedText group-hover:text-darkText transition-colors">Загрузить фото</span>
                                <input type="file" accept="image/*" multiple class="hidden" onchange="handleCarPhotoUpload(event, '${car.id}')">
                            </label>
                        </div>
                        
                        <!-- Описание (плавный переход) -->
                        <div class="bg-white rounded-xl border border-borderLight p-4 transition-all duration-300 focus-within:ring-1 focus-within:ring-black/20 focus-within:shadow-sm">
                            <textarea placeholder="Введите описание автомобиля, характеристики, особенности..." 
                                      class="w-full bg-transparent outline-none text-darkText font-weight-body text-sm md:text-base auto-resize transition-all duration-300"
                                      oninput="updateCarDescription('${car.id}', this)">${car.description}</textarea>
                        </div>
                    </div>
                </div>
            `).join('');
            
            // Триггер ресайза всех текстарей
            document.querySelectorAll('.auto-resize').forEach(el => {
                el.style.height = 'auto';
                el.style.height = (el.scrollHeight) + 'px';
            });
        }

        // Слайдер машин на главном экране (вытягивает все фото из CARS_DATA)
        let carSliderInterval;
        let currentCarIndex = 0;
        function renderCarShowcaseSlider() {
            const container = document.getElementById('carShowcaseContainer');
            if(!container) return;
            
            // Собираем все фото из всех добавленных машин
            let allPhotos = CARS_DATA.flatMap(c => c.photos);
            
            // Если ничего не добавлено, показываем пустой серый блок с иконкой
            if(allPhotos.length === 0) {
                container.innerHTML = `<div class="absolute inset-0 flex flex-col items-center justify-center text-mutedText"><i class="fa-solid fa-car text-6xl mb-4 opacity-50"></i><p>Автопарк не заполнен</p></div>`;
                clearInterval(carSliderInterval);
                return;
            }
            
            container.innerHTML = allPhotos.map((src, idx) => `
                <img src="${src}" id="car-slide-${idx}" class="absolute inset-0 w-full h-full object-cover transition-opacity duration-[1500ms] ease-in-out ${idx === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0'}">
            `).join('') + `<div class="absolute inset-0 bg-black/10 transition-colors z-20 pointer-events-none group-hover:bg-black/0"></div>`;
            
            clearInterval(carSliderInterval);
            if(allPhotos.length > 1) {
                carSliderInterval = setInterval(() => {
                    const prevIdx = currentCarIndex;
                    currentCarIndex = (currentCarIndex + 1) % allPhotos.length;
                    
                    const prevImg = document.getElementById(`car-slide-${prevIdx}`);
                    const nextImg = document.getElementById(`car-slide-${currentCarIndex}`);
                    
                    if(prevImg) { prevImg.classList.replace('opacity-100', 'opacity-0'); prevImg.classList.replace('z-10', 'z-0'); }
                    if(nextImg) { nextImg.classList.replace('opacity-0', 'opacity-100'); nextImg.classList.replace('z-0', 'z-10'); }
                }, 4000);
            }
        }


        // --- ЛОГИКА ЖИВОГО САЙТА (Live Feed) ---
        async function handleLiveFeedUpload(event) {
            if (!event.target.files.length) return;
            await processFilesForUpload(event.target.files, (data, name, type) => {
                LIVE_FEED_DATA.push({
                    id: 'live_' + Date.now() + Math.floor(Math.random()*100),
                    type: type,
                    src: data
                });
