<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>МУХУС — Большой Сухумский Дом | Ресторан</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;700&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-main: #F9F8F6;
            --bg-card: #FFFFFF;
            --bg-dark: #111111;
            --text-main: #1C1C1C;
            --text-muted: #666666;
            --text-light: #F9F8F6;
            --accent-burgundy: #3D1216;
            --accent-gold: #C5A059;
            --accent-gold-light: #E5C378;
            --font-logo: 'Cinzel Decorative', serif;
            --font-serif: 'Cormorant Garamond', Georgia, serif;
            --font-sans: 'Montserrat', sans-serif;
            --transition-smooth: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            background-color: var(--bg-main);
            color: var(--text-main);
            font-family: var(--font-sans);
            line-height: 1.7;
            font-weight: 300;
            -webkit-font-smoothing: antialiased;
            overflow-x: hidden;
        }

        /* --- SVG/CSS Custom Brand Emblem Logo Component --- */
        .brand-logo-graphic {
            display: inline-flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
        }

        .brand-logo-graphic svg {
            fill: none;
            stroke: currentColor;
        }

        /* --- 3D Intro Overlay --- */
        #intro-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background-color: #0d0607;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            perspective: 1000px;
            overflow: hidden;
            transition: opacity 0.8s cubic-bezier(0.77, 0, 0.175, 1), transform 0.8s cubic-bezier(0.77, 0, 0.175, 1);
        }

        #intro-overlay.hide {
            opacity: 0;
            transform: scale(1.15) rotateX(10deg);
            pointer-events: none !important;
            display: none !important;
        }

        .intro-bg-wrapper {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none !important; /* Отключаем перехват кликов фоном */
        }

        .intro-bg-wrapper img, .intro-bg-wrapper video, .intro-bg-video {
            position: absolute;
            top: 50%;
            left: 50%;
            min-width: 100%;
            min-height: 100%;
            width: auto;
            height: auto;
            transform: translate(-50%, -50%) scale(1.05);
            object-fit: cover;
            filter: brightness(0.35) contrast(1.1);
            transition: transform 10s ease-out;
            pointer-events: none !important; /* Отключаем клики по видео */
        }

        #intro-overlay:hover .intro-bg-wrapper img,
        #intro-overlay:hover .intro-bg-wrapper video {
            transform: translate(-50%, -50%) scale(1.12);
        }

        .intro-content {
            position: relative;
            z-index: 2;
            text-align: center;
            color: #FFFFFF;
            transform-style: preserve-3d;
            animation: intro3dFloat 6s ease-in-out infinite alternate;
            padding: 0 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        @keyframes intro3dFloat {
            0% { transform: translateZ(0px) rotateX(0deg) rotateY(0deg); }
            100% { transform: translateZ(40px) rotateX(4deg) rotateY(-4deg); }
        }

        .intro-logo-icon {
            width: 90px;
            height: 90px;
            margin-bottom: 15px;
            color: #C5A059;
        }

        .intro-logo-title {
            font-family: var(--font-logo);
            font-size: 52px;
            letter-spacing: 8px;
            color: #F3E5AB;
            text-shadow: 0 10px 25px rgba(0,0,0,0.8);
            margin-bottom: 5px;
            text-transform: uppercase;
        }

        .intro-sub {
            font-family: var(--font-serif);
            font-size: 18px;
            letter-spacing: 4px;
            color: #D4AF37;
            text-transform: uppercase;
            margin-bottom: 35px;
        }

        .btn-intro-enter {
            display: inline-block;
            padding: 18px 42px;
            background: linear-gradient(135deg, #3D1216 0%, #1A0709 100%);
            color: #F9F8F6;
            border: 1px solid #C5A059;
            font-family: var(--font-sans);
            font-size: 13px;
            letter-spacing: 3px;
            text-transform: uppercase;
            box-shadow: 0 15px 35px rgba(0,0,0,0.6);
            transition: all 0.4s ease;
            text-decoration: none;
        }

        /* ИСПРАВЛЕНИЕ ТЗ: CSS для гарантированного клика на мобильных устройствах */
        .enter-btn {
            position: relative !important;
            z-index: 9999 !important;
            pointer-events: auto !important;
            cursor: pointer;
            -webkit-tap-highlight-color: transparent;
        }

        .btn-intro-enter:hover {
            background: #C5A059;
            color: #111111;
            box-shadow: 0 20px 40px rgba(197, 160, 89, 0.4);
            transform: translateY(-3px) scale(1.03);
        }

        /* --- Header / Sticky Nav --- */
        header {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 1000;
            background-color: rgba(249, 248, 246, 0.96);
            backdrop-filter: blur(12px);
            padding: 12px 50px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: var(--transition-smooth);
            border-bottom: 1px solid rgba(0, 0, 0, 0.08);
        }

        .brand-logo-container {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
            color: var(--text-main);
        }

        .brand-logo-icon {
            width: 36px;
            height: 36px;
            color: var(--accent-burgundy);
        }

        .brand-logo-text {
            display: flex;
            flex-direction: column;
        }

        .brand-logo-main {
            font-family: var(--font-logo);
            font-size: 22px;
            font-weight: 700;
            letter-spacing: 3px;
            line-height: 1;
            color: var(--accent-burgundy);
        }

        .brand-logo-sub {
            font-family: var(--font-serif);
            font-size: 9px;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--text-muted);
            margin-top: 3px;
        }

        nav {
            display: flex;
            align-items: center;
            gap: 28px;
        }

        nav a {
            color: var(--text-main);
            text-decoration: none;
            font-size: 13px;
            letter-spacing: 1px;
            transition: opacity 0.3s ease;
        }

        nav a:hover {
            opacity: 0.6;
        }

        /* --- Luxurious Booking Button Component --- */
        .btn-luxury-reserve {
            position: relative;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 12px 28px;
            background: linear-gradient(135deg, #3D1216 0%, #1F0709 100%);
            color: #F9F8F6 !important;
            border: 1px solid #C5A059;
            font-family: var(--font-sans);
            font-size: 12px;
            font-weight: 500;
            letter-spacing: 2px;
            text-transform: uppercase;
            cursor: pointer;
            overflow: hidden;
            border-radius: 2px;
            box-shadow: 0 6px 20px rgba(61, 18, 22, 0.25);
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            text-decoration: none;
        }

        .btn-luxury-reserve::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: linear-gradient(60deg, transparent, rgba(197, 160, 89, 0.3), transparent);
            transform: rotate(30deg) translateY(-100%);
            transition: transform 0.8s ease;
        }

        .btn-luxury-reserve:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(197, 160, 89, 0.4);
            border-color: #E5C378;
            color: #FFFFFF !important;
        }

        .btn-luxury-reserve:hover::before {
            transform: rotate(30deg) translateY(100%);
        }

        .btn-admin-toggle {
            background: #EFEFEF;
            border: 1px solid #CCC;
            padding: 6px 12px;
            font-size: 11px;
            cursor: pointer;
            border-radius: 2px;
            transition: background 0.3s;
        }

        .btn-admin-toggle:hover {
            background: #E0E0E0;
        }

        /* --- Hero Section --- */
        .hero {
            position: relative;
            width: 100%;
            height: 88vh;
            margin-top: 65px;
            padding: 0 40px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
        }

        .hero-media-wrapper {
            position: absolute;
            top: 0;
            left: 40px;
            right: 40px;
            bottom: 0px;
            overflow: hidden;
            border-radius: 2px;
            background-color: #000;
        }

        .hero-media-wrapper img, .hero-media-wrapper video {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
            transition: transform 1.8s ease-out;
        }

        .hero:hover .hero-media-wrapper img,
        .hero:hover .hero-media-wrapper video {
            transform: scale(1.02);
        }

        .hero-overlay-dark {
            position: absolute;
            top: 0;
            left: 40px;
            right: 40px;
            bottom: 0px;
            background: linear-gradient(to top, rgba(0,0,0,0.75) 0%, rgba(0,0,0,0.3) 50%, rgba(0,0,0,0.5) 100%);
        }

        .hero-content {
            position: relative;
            z-index: 2;
            max-width: 800px;
            color: var(--text-light);
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        /* Centered Logo Badge in Hero Banner */
        .hero-center-logo {
            width: 110px;
            height: 110px;
            margin-bottom: 25px;
            border-radius: 50%;
            background: rgba(17, 17, 17, 0.6);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(197, 160, 89, 0.6);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 15px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
            color: #E5C378;
        }

        .hero-title {
            font-family: var(--font-serif);
            font-size: 64px;
            font-weight: 300;
            line-height: 1.1;
            margin-bottom: 30px;
            letter-spacing: 2px;
            text-shadow: 0 4px 20px rgba(0,0,0,0.6);
        }

        .hero-btn-group {
            display: flex;
            gap: 20px;
            align-items: center;
        }

        /* --- Announcement Strip --- */
        .announcement {
            padding: 25px 50px;
            text-align: center;
            background: #F1EFEA;
            border-bottom: 1px solid rgba(0,0,0,0.06);
            margin-top: 40px;
        }

        .announcement p {
            font-size: 13px;
            color: var(--text-muted);
            letter-spacing: 0.5px;
        }

        /* --- Editorial Letter Section --- */
        .editorial {
            max-width: 900px;
            margin: 90px auto;
            padding: 0 30px;
            text-align: center;
        }

        .editorial h2 {
            font-family: var(--font-serif);
            font-size: 42px;
            font-weight: 300;
            margin-bottom: 25px;
            line-height: 1.2;
            color: var(--accent-burgundy);
        }

        .editorial p {
            font-size: 16px;
            color: var(--text-muted);
            margin-bottom: 20px;
            line-height: 1.8;
        }

        .about-media-box {
            width: 100%;
            max-height: 480px;
            margin: 35px 0;
            overflow: hidden;
            border-radius: 2px;
            border: 1px solid #E5E5E5;
        }

        .about-media-box img, .about-media-box video {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .editorial .signature {
            font-family: var(--font-serif);
            font-size: 24px;
            font-style: italic;
            color: var(--text-main);
            margin-top: 25px;
        }

        /* --- Photo Grid (Noma Style - Two Columns) --- */
        .grid-section {
            max-width: 1400px;
            margin: 0 auto 100px;
            padding: 0 40px;
        }

        .grid-container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 40px;
        }

        @media (max-width: 850px) {
            .grid-container {
                grid-template-columns: 1fr;
            }
        }

        .grid-card {
            position: relative;
            display: flex;
            flex-direction: column;
            text-decoration: none;
            color: inherit;
            background: #FFF;
            padding: 15px;
            border: 1px solid #EAEAEA;
        }

        .grid-img-wrapper {
            width: 100%;
            height: 480px;
            overflow: hidden;
            background-color: #EFEFEF;
            margin-bottom: 20px;
            position: relative;
        }

        .grid-img-wrapper img, .grid-img-wrapper video {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
            transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .grid-card:hover .grid-img-wrapper img,
        .grid-card:hover .grid-img-wrapper video {
            transform: scale(1.04);
        }

        .grid-card-title {
            font-family: var(--font-serif);
            font-size: 26px;
            font-weight: 400;
            margin-bottom: 8px;
            line-height: 1.3;
        }

        .grid-card-desc {
            font-size: 13px;
            color: var(--text-muted);
            line-height: 1.6;
            margin-bottom: 15px;
        }

        .card-actions {
            margin-top: auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .btn-delete-card {
            background: #ff4d4d;
            color: white;
            border: none;
            padding: 5px 10px;
            font-size: 11px;
            cursor: pointer;
            border-radius: 2px;
            display: none;
        }

        /* --- Flexible Admin Panel Control --- */
        #admin-panel {
            display: none;
            position: fixed;
            bottom: 20px;
            right: 20px;
            background: #FFFFFF;
            border: 2px solid var(--accent-burgundy);
            padding: 22px;
            z-index: 2000;
            box-shadow: 0 15px 40px rgba(0,0,0,0.25);
            max-width: 380px;
            width: 90%;
            border-radius: 4px;
        }

        #admin-panel h3 {
            font-family: var(--font-serif);
            font-size: 22px;
            margin-bottom: 15px;
            color: var(--accent-burgundy);
            border-bottom: 1px solid #EEE;
            padding-bottom: 8px;
        }

        .admin-field {
            margin-bottom: 14px;
        }

        .admin-field label {
            display: block;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            margin-bottom: 5px;
            color: var(--text-muted);
        }

        .admin-field input, .admin-field textarea, .admin-field select {
            width: 100%;
            padding: 9px;
            font-size: 12px;
            border: 1px solid #CCC;
            border-radius: 2px;
            font-family: var(--font-sans);
        }

        .btn-admin-submit {
            background: var(--accent-burgundy);
            color: white;
            border: none;
            padding: 12px;
            width: 100%;
            cursor: pointer;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: 500;
            transition: background 0.3s;
        }

        .btn-admin-submit:hover {
            background: #23090B;
        }

        .btn-reset-demo {
            background: #777;
            color: white;
            border: none;
            padding: 7px;
            width: 100%;
            cursor: pointer;
            font-size: 11px;
            margin-top: 10px;
        }

        /* --- Interactive Booking Modal (Демо-система) --- */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(17, 17, 17, 0.85);
            backdrop-filter: blur(8px);
            z-index: 5000;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.4s ease;
            padding: 20px;
        }

        .modal-overlay.active {
            opacity: 1;
            pointer-events: auto;
        }

        .booking-modal {
            background: #FFFFFF;
            width: 100%;
            max-width: 580px;
            padding: 40px;
            border-radius: 2px;
            position: relative;
            box-shadow: 0 25px 60px rgba(0,0,0,0.4);
            transform: translateY(20px);
            transition: transform 0.4s ease;
            border: 1px solid var(--accent-gold);
            max-height: 90vh;
            overflow-y: auto;
        }

        .modal-overlay.active .booking-modal {
            transform: translateY(0);
        }

        .modal-close-btn {
            position: absolute;
            top: 20px;
            right: 20px;
            background: transparent;
            border: none;
            font-size: 24px;
            cursor: pointer;
            color: var(--text-muted);
            line-height: 1;
        }

        .booking-modal-header {
            text-align: center;
            margin-bottom: 30px;
        }

        .booking-modal-header h3 {
            font-family: var(--font-serif);
            font-size: 32px;
            color: var(--accent-burgundy);
            margin-bottom: 6px;
        }

        .booking-modal-header p {
            font-size: 13px;
            color: var(--text-muted);
        }

        .booking-form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        @media (max-width: 500px) {
            .booking-form-grid {
                grid-template-columns: 1fr;
            }
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .form-group.full-width {
            grid-column: 1 / -1;
        }

        .form-group label {
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--text-muted);
            font-weight: 500;
        }

        .form-group input, .form-group select, .form-group textarea {
            padding: 12px;
            border: 1px solid #DDD;
            border-radius: 2px;
            font-family: var(--font-sans);
            font-size: 13px;
            background: #FAFAFA;
            transition: border-color 0.3s;
        }

        .form-group input:focus, .form-group select:focus, .form-group textarea:focus {
            border-color: var(--accent-gold);
            outline: none;
            background: #FFF;
        }

        .booking-success-box {
            display: none;
            text-align: center;
            padding: 20px 0;
        }

        .booking-success-box h4 {
            font-family: var(--font-serif);
            font-size: 28px;
            color: var(--accent-burgundy);
            margin-bottom: 12px;
        }

        .booking-ticket {
            background: #F9F8F6;
            border: 1px dashed var(--accent-gold);
            padding: 20px;
            margin: 20px 0;
            text-align: left;
            font-size: 13px;
            line-height: 1.8;
        }

        /* --- Menu List Section --- */
        .menu-section {
            max-width: 900px;
            margin: 0 auto 120px;
            padding: 0 30px;
        }

        .section-title {
            font-family: var(--font-serif);
            font-size: 38px;
            font-weight: 300;
            text-align: center;
            margin-bottom: 50px;
            color: var(--accent-burgundy);
        }

        .menu-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 40px 60px;
        }

        @media (max-width: 650px) {
            .menu-grid {
                grid-template-columns: 1fr;
            }
        }

        .menu-item {
            border-bottom: 1px solid rgba(0,0,0,0.08);
            padding-bottom: 12px;
            display: flex;
            justify-content: space-between;
            align-items: baseline;
        }

        .menu-item-name {
            font-family: var(--font-serif);
            font-size: 21px;
        }

        .menu-item-price {
            font-size: 14px;
            color: var(--text-muted);
        }

        /* --- Atmosphere / Reviews --- */
        .reviews-section {
            max-width: 1100px;
            margin: 0 auto 120px;
            padding: 0 30px;
        }

        .reviews-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
        }

        .review-card {
            background-color: var(--bg-card);
            padding: 40px 30px;
            border: 1px solid rgba(0,0,0,0.05);
            border-radius: 2px;
            transition: var(--transition-smooth);
        }

        .review-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.04);
        }

        .review-text {
            font-family: var(--font-serif);
            font-size: 18px;
            line-height: 1.6;
            margin-bottom: 20px;
            font-style: italic;
        }

        .review-author {
            font-size: 11px;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: var(--text-muted);
        }

        /* --- Minimal Footer --- */
        footer {
            background-color: var(--bg-dark);
            color: var(--text-light);
            padding: 90px 50px 40px;
            font-size: 13px;
        }

        .footer-grid {
            max-width: 1300px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 40px;
            margin-bottom: 80px;
        }

        .footer-col h4 {
            font-family: var(--font-serif);
            font-size: 20px;
            font-weight: 300;
            margin-bottom: 20px;
            color: var(--accent-gold);
        }

        .footer-col p, .footer-col ul {
            color: #A0A0A0;
            line-height: 1.9;
            list-style: none;
        }

        .footer-col a {
            color: #A0A0A0;
            text-decoration: none;
            transition: color 0.3s;
        }

        .footer-col a:hover {
            color: #FFFFFF;
        }

        .footer-bottom {
            max-width: 1300px;
            margin: 0 auto;
            padding-top: 40px;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            display: flex;
            justify-content: space-between;
            align-items: center;
            color: #777777;
            font-size: 11px;
            flex-wrap: wrap;
            gap: 20px;
        }

        .footer-brand-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            margin-top: 15px;
        }

        .footer-brand-logo .logo-title {
            font-family: var(--font-logo);
            font-size: 24px;
            color: #FFFFFF;
            letter-spacing: 3px;
        }

        .footer-brand-logo .logo-sub {
            font-family: var(--font-serif);
            font-size: 10px;
            color: var(--accent-gold);
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        /* Scroll Animations */
        .fade-in {
            opacity: 0;
            transform: translateY(20px);
            transition: opacity 1s ease-out, transform 1s ease-out;
        }

        .fade-in.visible {
            opacity: 1;
            transform: translateY(0);
        }

        /* --- Mobile Responsiveness Fixes (@media) --- */
        @media (max-width: 768px) {
            html, body {
                overflow-x: hidden !important;
                overflow-y: auto !important;
                height: auto !important;
                position: relative !important;
            }

            header {
                padding: 10px 20px;
            }

            nav a, .btn-admin-toggle {
                display: none;
            }

            .hero {
                padding: 0 15px;
                height: 80vh;
            }

            .hero-media-wrapper, .hero-overlay-dark {
                left: 10px;
                right: 10px;
            }

            .hero-title {
                font-size: 38px;
            }

            .intro-logo-title {
                font-size: 36px;
            }

            .intro-sub {
                font-size: 14px;
            }

            .btn-intro-enter {
                padding: 14px 28px;
                font-size: 11px;
            }
        }
    </style>
</head>
<body>

    <!-- 3D Intro Splash Overlay -->
    <div id="intro-overlay">
        <div class="intro-bg-wrapper" id="intro-media-container">
            <video class="intro-bg-video" autoplay loop muted playsinline webkit-playsinline preload="auto" src="https://assets.mixkit.co/videos/preview/mixkit-top-view-of-a-restaurant-table-41551-large.mp4"></video>
        </div>
        <div class="intro-content">
            <!-- Central Emblem Icon -->
            <svg class="intro-logo-icon" viewBox="0 0 100 100">
                <circle cx="50" cy="50" r="45" stroke="#C5A059" stroke-width="1.5" fill="none"/>
                <path d="M30 65 Q 50 35 70 65" stroke="#C5A059" stroke-width="1.5" fill="none"/>
                <circle cx="50" cy="40" r="6" fill="#C5A059"/>
            </svg>
            <div class="intro-logo-title">М̀ҮХҮС</div>
            <div class="intro-sub">Большой Сухумский Дом • Est. 2020</div>
            <!-- ИСПРАВЛЕНИЕ ТЗ: Использование правильного тега <button type="button"> -->
            <button type="button" class="btn-intro-enter enter-btn">ЗАБРОНИРОВАТЬ & ВХОД</button>
        </div>
    </div>

    <!-- Sticky Navigation -->
    <header>
        <a href="#" class="brand-logo-container">
            <!-- Emblem SVG -->
            <svg class="brand-logo-icon" viewBox="0 0 60 60">
                <circle cx="30" cy="30" r="27" stroke="currentColor" stroke-width="1.5" fill="none"/>
                <path d="M18 40 Q 30 20 42 40" stroke="currentColor" stroke-width="1.5" fill="none"/>
                <circle cx="30" cy="24" r="4" fill="currentColor"/>
            </svg>
            <div class="brand-logo-text">
                <span class="brand-logo-main">М̀ҮХҮС</span>
                <span class="brand-logo-sub">Большой Сухумский Дом</span>
            </div>
        </a>

        <nav>
            <a href="#about">О нас</a>
            <a href="#menu">Меню</a>
            <a href="#stories">Галерея</a>
            <a href="#atmosphere">Атмосфера</a>
            <a href="#contacts">Контакты</a>
            <button class="btn-luxury-reserve" onclick="openBookingModal()">Забронировать</button>
            <button class="btn-admin-toggle" onclick="toggleAdminPanel()">Изменить медиа</button>
        </nav>
    </header>

    <!-- Main Hero Section -->
    <section class="hero">
        <div class="hero-media-wrapper" id="hero-media-container">
            <img src="https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?q=80&w=1600&auto=format&fit=crop" id="hero-media-element" alt="Ресторан Мухус">
        </div>
        <div class="hero-overlay-dark"></div>
        <div class="hero-content">
            <!-- Centered Emblem Badge -->
            <div class="hero-center-logo">
                <svg viewBox="0 0 100 100" style="width:100%; height:100%; fill:none; stroke:currentColor;">
                    <circle cx="50" cy="50" r="46" stroke-width="1.5"/>
                    <path d="M25 65 Q 50 30 75 65" stroke-width="1.5"/>
                    <circle cx="50" cy="38" r="7" fill="currentColor"/>
                    <text x="50%" y="82%" text-anchor="middle" fill="currentColor" font-size="10" font-family="Cinzel Decorative" stroke="none">MYXYC</text>
                </svg>
            </div>
            <!-- Modified Hero Title -->
            <h1 class="hero-title">Добро пожаловать</h1>
            <div class="hero-btn-group">
                <button class="btn-luxury-reserve" style="padding: 16px 36px; font-size: 13px;" onclick="openBookingModal()">Забронировать стол</button>
            </div>
        </div>
    </section>

    <!-- Announcement Bar -->
    <div class="announcement">
        <p>Подпишитесь на рассылку для получения анонсов гастрономических вечеров и обновлений меню.</p>
    </div>

    <!-- Editorial Statement / About Section -->
    <section id="about" class="editorial fade-in">
        <h2>Традиции & Высокое Гостеприимство</h2>
        <p>Наш ресторан — это место, где традиции встречаются с уютным стилем. Интерьер с красным роялем, антикварной мебелью, хрусталем и уникальной атмосферой родного дома.</p>
        
        <!-- Editable Media Box for About Section -->
        <div class="about-media-box" id="about-media-container">
            <img src="https://images.unsplash.com/photo-1550966871-3ed3cdb5ed0c?q=80&w=1200&auto=format&fit=crop" alt="Интерьер Мухус">
        </div>

        <p>Каждое блюдо — от сочных хинкали ручной лепки до авторского кофе с гранатом — создается с любовью и уважением к истории нашей земли.</p>
        <div class="signature">— Команда Мухус</div>
    </section>

    <!-- Photo & Video Cards Grid -->
    <section id="stories" class="grid-section">
        <div class="grid-container" id="cards-container">
            <!-- Dynamic cards generated via JavaScript -->
        </div>
    </section>

    <!-- Minimal Menu Section -->
    <section id="menu" class="menu-section fade-in">
        <h2 class="section-title">Избранное из меню</h2>
        <div class="menu-grid">
            <div class="menu-item">
                <span class="menu-item-name">Ачапа из шпината</span>
                <span class="menu-item-price">370 ₽</span>
            </div>
            <div class="menu-item">
                <span class="menu-item-name">Ачамгыс копченый</span>
                <span class="menu-item-price">280 ₽</span>
            </div>
            <div class="menu-item">
                <span class="menu-item-name">Фирменные хинкали</span>
                <span class="menu-item-price">от 90 ₽</span>
            </div>
            <div class="menu-item">
                <span class="menu-item-name">Салат с баклажаном</span>
                <span class="menu-item-price">450 ₽</span>
            </div>
            <div class="menu-item">
                <span class="menu-item-name">Креветки с чесноком</span>
                <span class="menu-item-price">680 ₽</span>
            </div>
            <div class="menu-item">
                <span class="menu-item-name">Домашнее вино</span>
                <span class="menu-item-price">350 ₽</span>
            </div>
        </div>
    </section>

    <!-- Atmosphere & Reviews -->
    <section id="atmosphere" class="reviews-section fade-in">
        <h2 class="section-title">Гости о нас</h2>
        <div class="reviews-grid">
            <div class="review-card">
                <div class="review-text">«Интерьер, чистота и обслуживание — безупречно! Красный рояль, старинная мебель и хрусталь создают невероятную атмосферу.»</div>
                <div class="review-author">— Елена В.</div>
            </div>
            <div class="review-card">
                <div class="review-text">«Очень атмосферный ресторан. Попробовали мамалыгу с сыром и оригинальный кофе с гранатом. Рекомендую каждым сердцем!»</div>
                <div class="review-author">— Наталья</div>
            </div>
            <div class="review-card">
                <div class="review-text">«Просторный зал и веранда. Коллекция винтажных статуэток создает домашний и теплый дух Большого Сухумского дома.»</div>
                <div class="review-author">— Юлия</div>
            </div>
        </div>
    </section>

    <!-- Footer Grid -->
    <footer id="contacts">
        <div class="footer-grid">
            <div class="footer-col">
                <h4>Контакты</h4>
                <p>Ресторан «МУХУС»</p>
                <p>Абаза амҩа, 100</p>
                <p>Ориентир: Стадион (98 м)</p>
                <p style="margin-top: 10px;"><a href="tel:+79407253590">+7 (940) 725-35-90</a></p>
            </div>

            <div class="footer-col">
                <h4>Часы работы</h4>
                <p>Понедельник — Воскресенье</p>
                <p>10:00 – 23:00</p>
                <p style="margin-top: 15px; color: #FFFFFF;">Средний чек: 1 200 – 2 500 ₽</p>
            </div>

            <div class="footer-col">
                <h4>Услуги</h4>
                <ul>
                    <li><a href="javascript:void(0)" onclick="openBookingModal()">Забронировать стол</a></li>
                    <li><a href="#">Доставка & Навынос</a></li>
                    <li><a href="#">Летняя веранда</a></li>
                    <li><a href="#">Банкеты и мероприятия</a></li>
                </ul>
            </div>

            <div class="footer-col">
                <h4>Социальные сети</h4>
                <ul>
                    <li><a href="#">Instagram</a></li>
                    <li><a href="#">Telegram</a></li>
                    <li><a href="#">Яндекс Карты (5.0 ★)</a></li>
                </ul>
            </div>
        </div>

        <div class="footer-bottom">
            <div>
                © 2020–2026 Ресторан «МУХУС». Все права защищены.
                <a href="#" class="footer-brand-logo">
                    <svg viewBox="0 0 60 60" style="width:24px; height:24px; color:#C5A059;">
                        <circle cx="30" cy="30" r="27" stroke="currentColor" stroke-width="1.5" fill="none"/>
                        <path d="M18 40 Q 30 20 42 40" stroke="currentColor" stroke-width="1.5" fill="none"/>
                        <circle cx="30" cy="24" r="4" fill="currentColor"/>
                    </svg>
                    <div>
                        <span class="logo-title">М̀ҮХҮС</span>
                        <span class="logo-sub">Большой Сухумский Дом</span>
                    </div>
                </a>
            </div>
            <div>Дизайн выполнен в эстетике Noma / Muhus</div>
        </div>
    </footer>

    <!-- Comprehensive Admin Panel Control for Direct Section Uploads -->
    <div id="admin-panel">
        <h3>Управление Медиа</h3>
        
        <div class="admin-field">
            <label>1. Куда добавить медиафайл?</label>
            <select id="upload-target-select">
                <option value="hero">Главный баннер (Hero)</option>
                <option value="intro">Загрузочный 3D-экран (Intro)</option>
                <option value="about">Раздел «О нас» (Интерьер)</option>
                <option value="gallery">Галерея карточек</option>
            </select>
        </div>

        <div class="admin-field">
            <label>2. Файл (Фото или Видео):</label>
            <input type="file" id="media-file-input" accept="image/*,video/*">
        </div>

        <div class="admin-field">
            <label>3. Заголовок (Необязательно):</label>
            <input type="text" id="card-title-input" placeholder="Заголовок карточки...">
        </div>
        
        <div class="admin-field">
            <label>4. Описание (Необязательно):</label>
            <textarea id="card-desc-input" placeholder="Описание карточки..." rows="2"></textarea>
        </div>

        <button class="btn-admin-submit" onclick="handleAdminUpload()">Загрузить & Сохранить</button>
        <button class="btn-reset-demo" onclick="resetToDemoData()">Сбросить к исходным демо</button>
    </div>

    <!-- Booking Modal System -->
    <div class="modal-overlay" id="booking-modal-overlay">
        <div class="booking-modal">
            <button class="modal-close-btn" onclick="closeBookingModal()">&times;</button>
            
            <div id="booking-form-content">
                <div class="booking-modal-header">
                    <h3>Забронировать стол</h3>
                    <p>Большой Сухумский Дом • Ресторан «МУХУС»</p>
                </div>
                
                <form id="booking-form" onsubmit="submitBooking(event)">
                    <div class="booking-form-grid">
                        <div class="form-group">
                            <label>Ваше Имя *</label>
                            <input type="text" id="book-name" required placeholder="Константин">
                        </div>
                        <div class="form-group">
                            <label>Телефон *</label>
                            <input type="tel" id="book-phone" required placeholder="+7 (940) 000-00-00">
                        </div>
                        <div class="form-group">
                            <label>Количество гостей</label>
                            <select id="book-guests">
                                <option value="1 персона">1 персона</option>
                                <option value="2 персоны" selected>2 персоны</option>
                                <option value="3 персоны">3 персоны</option>
                                <option value="4 персоны">4 персоны</option>
                                <option value="5-6 персон">5-6 персон</option>
                                <option value="7+ персон (Банкет)">7+ персон (Банкет)</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Дата визита *</label>
                            <input type="date" id="book-date" required>
                        </div>
                        <div class="form-group">
                            <label>Время</label>
                            <select id="book-time">
                                <option value="12:00">12:00</option>
                                <option value="14:00">14:00</option>
                                <option value="16:00">16:00</option>
                                <option value="18:00">18:00</option>
                                <option value="19:30" selected>19:30</option>
                                <option value="21:00">21:00</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Зона посадки</label>
                            <select id="book-zone">
                                <option value="Зал у Красного Рояля">Зал у Красного Рояля</option>
                                <option value="Уютный Каминный Зал">Уютный Каминный Зал</option>
                                <option value="Летняя Веранда">Летняя Веранда</option>
                                <option value="Любая свободная зона">Любая свободная зона</option>
                            </select>
                        </div>
                        <div class="form-group full-width">
                            <label>Пожелания и нюансы</label>
                            <textarea id="book-notes" rows="3" placeholder="Особые предпочтения, день рождения, аллергии, тихое место..."></textarea>
                        </div>
                    </div>
                    <div style="margin-top: 25px;">
                        <button type="submit" class="btn-luxury-reserve" style="width: 100%; padding: 16px;">Подтвердить бронирование</button>
                    </div>
                </form>
            </div>

            <!-- Success Confirmation Screen -->
            <div class="booking-success-box" id="booking-success-box">
                <h4>Ваш стол забронирован!</h4>
                <p style="font-size: 13px; color: var(--text-muted);">Мы свяжемся с вами в ближайшее время для подтверждения.</p>
                
                <div class="booking-ticket" id="ticket-details">
                    <!-- Dynamic Ticket Content -->
                </div>

                <button class="btn-luxury-reserve" style="width: 100%;" onclick="closeBookingModal()">Закрыть</button>
            </div>
        </div>
    </div>

    <!-- JavaScript Logic -->
    <script>
        // Исходные демонстрационные карточки
        const defaultCards = [
            {
                id: 'demo1',
                type: 'image',
                src: 'https://images.unsplash.com/photo-1541544741938-0af808871cc0?q=80&w=800&auto=format&fit=crop',
                title: 'Сочные Хинкали Ручной Лепки',
                desc: 'Визитная карточка Мухуса. Готовятся исключительно вручную прямо для вас — свежие, ароматные, с богатым бульонами.'
            },
            {
                id: 'demo2',
                type: 'image',
                src: 'https://images.unsplash.com/photo-1540420773420-3366772f4999?q=80&w=800&auto=format&fit=crop',
                title: 'Хрустящий Баклажан & Нежный Сыр',
                desc: 'Один из самых любимых салатов наших гостей. Гармония хрустящей корочки, свежей кинзы и фирменного соуса.'
            },
            {
                id: 'demo3',
                type: 'image',
                src: 'https://images.unsplash.com/photo-1550966871-3ed3cdb5ed0c?q=80&w=800&auto=format&fit=crop',
                title: 'Атмосфера & Антиквариат',
                desc: 'Красный рояль, коллекция редких фарфоровых фигурок, хрусталь и уютный зеленый дворик для теплых вечеров.'
            },
            {
                id: 'demo4',
                type: 'image',
                src: 'https://images.unsplash.com/photo-1534422298391-e4f8c172dddb?q=80&w=800&auto=format&fit=crop',
                title: 'Креветки на Сковороде с Чесноком',
                desc: 'Аромат свежей зелени, молодой чеснок и румяный свежий хлеб, идеально впитывающий пряный соус.'
            }
        ];

        let cardsData = [];
        let isAdminActive = false;

        document.addEventListener('DOMContentLoaded', () => {
            loadSavedMedia();
            loadCardsData();
            initObserver();
            setupVideoFallback();
            setupEnterButton(); // Подключение обработчика событий кнопки входа по ТЗ
            
            // Set min date for booking calendar
            const today = new Date().toISOString().split('T')[0];
            const dateInput = document.getElementById('book-date');
            if(dateInput) {
                dateInput.min = today;
                dateInput.value = today;
            }
        });

        // Fallback protection from preloader hanging (2-3 sec timeout)
        function setupVideoFallback() {
            const introVideo = document.querySelector('.intro-bg-video');
            let videoLoaded = false;

            if (introVideo) {
                introVideo.addEventListener('canplaythrough', () => {
                    videoLoaded = true;
                });

                // Fallback: Force display content after 3s if video is blocked/slow
                setTimeout(() => {
                    if (!videoLoaded) {
                        document.body.style.overflow = 'auto';
                        document.documentElement.style.overflow = 'auto';
                    }
                }, 3000);
            }
        }

        // ИСПРАВЛЕНИЕ ТЗ: Добавление универсального обработчика событий касания и кликов
        function handleEnter(e) {
            if (e) e.preventDefault();
            const overlay = document.getElementById('intro-overlay');
            if (overlay) {
                overlay.style.opacity = '0';
                setTimeout(() => {
                    overlay.style.display = 'none';
                }, 300);
            }
            document.body.style.overflow = 'auto';
            document.body.style.position = 'static';
            document.documentElement.style.overflow = 'auto';

            openBookingModal();
        }

        function setupEnterButton() {
            const btn = document.querySelector('.enter-btn');
            if (btn) {
                btn.addEventListener('click', handleEnter);
                btn.addEventListener('touchstart', handleEnter, { passive: false });
            }
        }

        // Toggle Admin Panel
        function toggleAdminPanel() {
            const panel = document.getElementById('admin-panel');
            isAdminActive = !isAdminActive;
            panel.style.display = isAdminActive ? 'block' : 'none';
            renderCards();
        }

        // Handle File Upload to Specific Site Sections
        function handleAdminUpload() {
            const target = document.getElementById('upload-target-select').value;
            const fileInput = document.getElementById('media-file-input');
            const title = document.getElementById('card-title-input').value.trim();
            const desc = document.getElementById('card-desc-input').value.trim();
            const file = fileInput.files[0];

            if (!file && target !== 'gallery') {
                alert('Пожалуйста, выберите медиафайл.');
                return;
            }

            if (file) {
                const reader = new FileReader();
                reader.onload = function(evt) {
                    const mediaData = {
                        type: file.type.startsWith('video') ? 'video' : 'image',
                        src: evt.target.result
                    };

                    if (target === 'hero') {
                        localStorage.setItem('muhus_hero_media', JSON.stringify(mediaData));
                        applyMediaToContainer('hero-media-container', mediaData);
                    } else if (target === 'intro') {
                        localStorage.setItem('muhus_intro_media', JSON.stringify(mediaData));
                        applyMediaToContainer('intro-media-container', mediaData);
                    } else if (target === 'about') {
                        localStorage.setItem('muhus_about_media', JSON.stringify(mediaData));
                        applyMediaToContainer('about-media-container', mediaData);
                    } else if (target === 'gallery') {
                        const newCard = {
                            id: 'card_' + Date.now(),
                            type: mediaData.type,
                            src: mediaData.src,
                            title: title || 'Атмосфера Мухус',
                            desc: desc || ''
                        };
                        cardsData.unshift(newCard);
                        localStorage.setItem('muhus_cards', JSON.stringify(cardsData));
                        renderCards();
                    }

                    // Reset Input Fields
                    fileInput.value = '';
                    document.getElementById('card-title-input').value = '';
                    document.getElementById('card-desc-input').value = '';
                    alert('Медиафайл успешно обновлен!');
                };
                reader.readAsDataURL(file);
            }
        }

        function applyMediaToContainer(containerId, media) {
            const container = document.getElementById(containerId);
            if (!container) return;

            if (media.type === 'video') {
                container.innerHTML = `<video autoplay loop muted playsinline webkit-playsinline preload="auto" src="${media.src}"></video>`;
            } else {
                container.innerHTML = `<img src="${media.src}" alt="Ресторан МУХУС">`;
            }
        }

        function loadSavedMedia() {
            // Load Hero Media
            const savedHero = localStorage.getItem('muhus_hero_media');
            if (savedHero) try { applyMediaToContainer('hero-media-container', JSON.parse(savedHero)); } catch(e){}

            // Load Intro Media
            const savedIntro = localStorage.getItem('muhus_intro_media');
            if (savedIntro) try { applyMediaToContainer('intro-media-container', JSON.parse(savedIntro)); } catch(e){}

            // Load About Media
            const savedAbout = localStorage.getItem('muhus_about_media');
            if (savedAbout) try { applyMediaToContainer('about-media-container', JSON.parse(savedAbout)); } catch(e){}
        }

        // Load & Render Gallery Cards
        function loadCardsData() {
            const saved = localStorage.getItem('muhus_cards');
            if (saved) {
                try {
                    cardsData = JSON.parse(saved);
                } catch(e) {
                    cardsData = [...defaultCards];
                }
            } else {
                cardsData = [...defaultCards];
            }
            renderCards();
        }

        function renderCards() {
            const container = document.getElementById('cards-container');
            if(!container) return;
            container.innerHTML = '';

            cardsData.forEach(card => {
                const cardEl = document.createElement('div');
                cardEl.className = 'grid-card fade-in visible';

                let mediaHTML = '';
                if (card.type === 'video') {
                    mediaHTML = `<video autoplay loop muted playsinline webkit-playsinline preload="auto" src="${card.src}"></video>`;
                } else {
                    mediaHTML = `<img src="${card.src}" alt="${card.title || 'Мухус'}">`;
                }

                cardEl.innerHTML = `
                    <div class="grid-img-wrapper">
                        ${mediaHTML}
                    </div>
                    ${card.title ? `<div class="grid-card-title">${card.title}</div>` : ''}
                    ${card.desc ? `<div class="grid-card-desc">${card.desc}</div>` : ''}
                    <div class="card-actions">
                        <a href="javascript:void(0)" onclick="openBookingModal()" style="font-size: 12px; color: var(--text-main); border-bottom: 1px solid var(--text-main); text-decoration: none;">Забронировать стол</a>
                        <button class="btn-delete-card" style="display: ${isAdminActive ? 'inline-block' : 'none'}" onclick="deleteCard('${card.id}')">Удалить</button>
                    </div>
                `;
                container.appendChild(cardEl);
            });
        }

        // Delete Card
        function deleteCard(id) {
            cardsData = cardsData.filter(c => c.id !== id);
            localStorage.setItem('muhus_cards', JSON.stringify(cardsData));
            renderCards();
        }

        // Reset to Original Demo Data
        function resetToDemoData() {
            if (confirm('Сбросить все фото и карточки к исходным настрокам?')) {
                localStorage.removeItem('muhus_cards');
                localStorage.removeItem('muhus_hero_media');
                localStorage.removeItem('muhus_intro_media');
                localStorage.removeItem('muhus_about_media');
                location.reload();
            }
        }

        // --- Booking Modal Demo Logic ---
        function openBookingModal() {
            document.getElementById('booking-modal-overlay').classList.add('active');
            document.getElementById('booking-form-content').style.display = 'block';
            document.getElementById('booking-success-box').style.display = 'none';
        }

        function closeBookingModal() {
            document.getElementById('booking-modal-overlay').classList.remove('active');
        }

        function submitBooking(e) {
            e.preventDefault();
            
            const name = document.getElementById('book-name').value;
            const phone = document.getElementById('book-phone').value;
            const guests = document.getElementById('book-guests').value;
            const date = document.getElementById('book-date').value;
            const time = document.getElementById('book-time').value;
            const zone = document.getElementById('book-zone').value;
            const notes = document.getElementById('book-notes').value;

            const ticketId = 'MH-' + Math.floor(1000 + Math.random() * 9000);

            const ticketHTML = `
                <p><strong>Номер брони:</strong> <span style="color:var(--accent-burgundy); font-weight:600;">#${ticketId}</span></p>
                <p><strong>Гость:</strong> ${name} (${phone})</p>
                <p><strong>Дата и время:</strong> ${date} в ${time}</p>
                <p><strong>Количество:</strong> ${guests}</p>
                <p><strong>Зона:</strong> ${zone}</p>
                ${notes ? `<p><strong>Пожелания:</strong> ${notes}</p>` : ''}
            `;

            document.getElementById('ticket-details').innerHTML = ticketHTML;
            document.getElementById('booking-form-content').style.display = 'none';
            document.getElementById('booking-success-box').style.display = 'block';
        }

        // Intersection Observer for Scroll Animations
        function initObserver() {
            const observerOptions = { threshold: 0.15 };
            const observer = new IntersectionObserver((entries, obs) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('visible');
                        obs.unobserve(entry.target);
                    }
                });
            }, observerOptions);

            document.querySelectorAll('.fade-in').forEach(el => {
                observer.observe(el);
            });
        }
    </script>
</body>
</html>
