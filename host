      const canvas = document.createElement('canvas');
      canvas.width = 600;
      canvas.height = 400;
      const ctx = canvas.getContext('2d');

      ctx.fillStyle = '#1A1A1E';
      ctx.fillRect(0, 0, 600, 400);

      ctx.strokeStyle = '#D4AF37';
      ctx.lineWidth = 6;
      ctx.strokeRect(20, 20, 560, 360);

      ctx.fillStyle = '#FFD700';
      ctx.font = '30px serif';
      ctx.textAlign = 'center';
      ctx.fillText('СЕРТИФИКАТ AURA', 300, 100);

      ctx.fillStyle = '#FFFFFF';
      ctx.font = '16px sans-serif';
      ctx.fillText('Настоящим подтверждается прохождение модуля', 300, 160);
      ctx.fillText('Религиоведение & Академическая Философия', 300, 200);

      ctx.fillStyle = '#8E8E93';
      ctx.font = '12px sans-serif';
      ctx.fillText(`Дата выдачи: ${new Date().toLocaleDateString()}`, 300, 280);

      const link = document.createElement('a');
      link.download = 'aura-certificate.png';
      link.href = canvas.toDataURL();
      link.click();
    }

    // Избранное
    function renderFavorites() {
      const container = document.getElementById('favorites-list');
      container.innerHTML = '';

      if (favorites.length === 0) {
        container.innerHTML = `<div style="text-align:center; color:var(--text-secondary); padding:40px 0; font-size:13px;">У вас пока нет избранных цитат</div>`;
        return;
      }

      favorites.forEach(id => {
        const q = philosophersData.find(item => item.id === id);
        if (!q) return;

        const card = document.createElement('div');
        card.className = 'fav-card';
        card.innerHTML = `
          <div class="fav-card-header">
            <div>
              <div class="fav-author-name">${q.author}</div>
              <div class="fav-author-era">${q.era}</div>
            </div>
            <i data-lucide="trash-2" class="fav-card-delete" onclick="removeFavorite(${q.id})"></i>
          </div>
          <div class="fav-book-badge">Главный труд: ${q.book}</div>
          <div class="fav-quote-text">${q.text}</div>
          <div class="fav-exp-toggle" onclick="toggleFavExp(this)">
            <span>Объяснение</span>
            <i data-lucide="chevron-down" style="width:14px; height:14px;"></i>
          </div>
          <div class="fav-exp-wrapper">
            <div class="fav-exp-content">${q.exp}</div>
          </div>
        `;
        container.appendChild(card);
      });
      lucide.createIcons();
    }

    window.toggleFavExp = function(element) {
      const wrapper = element.nextElementSibling;
      wrapper.classList.toggle('open');
    };

    window.removeFavorite = function(id) {
      const idx = favorites.indexOf(id);
      if (idx > -1) {
        favorites.splice(idx, 1);
        localStorage.setItem('aura_favs', JSON.stringify(favorites));
        renderFavorites();
        displayQuote(currentQuoteIndex);
      }
    };

    // Навигация и Темы
    const themeToggle = document.getElementById('theme-toggle');
    if (localStorage.getItem('aura_theme') === 'dark') {
      document.documentElement.setAttribute('data-theme', 'dark');
      themeToggle.checked = true;
    }

    themeToggle.addEventListener('change', (e) => {
      if (e.target.checked) {
        document.documentElement.setAttribute('data-theme', 'dark');
        localStorage.setItem('aura_theme', 'dark');
      } else {
        document.documentElement.removeAttribute('data-theme');
        localStorage.setItem('aura_theme', 'light');
      }
    });

    const navItems = document.querySelectorAll('.nav-item');
    const content = document.getElementById('main-content');

    navItems.forEach(item => {
      item.addEventListener('click', () => {
        playUISound(350);
        const targetId = item.getAttribute('data-target');
        document.getElementById(targetId)?.scrollIntoView({ behavior: 'smooth', inline: 'start' });
      });
    });

    content.addEventListener('scroll', () => {
      const width = content.clientWidth;
      if (!width) return;
      const activeIndex = Math.round(content.scrollLeft / width);
      navItems.forEach((item, index) => {
        if (index === activeIndex) {
          item.classList.add('active');
          if (item.getAttribute('data-target') === 'view-favorites') renderFavorites();
        } else {
          item.classList.remove('active');
        }
      });
    });

    document.getElementById('btn-quick-settings').addEventListener('click', () => {
      document.getElementById('view-settings')?.scrollIntoView({ behavior: 'smooth', inline: 'start' });
    });

    document.getElementById('btn-achievements').addEventListener('click', () => {
      document.getElementById('badges-modal').classList.add('active');
    });

    // Окно поиска
    document.getElementById('btn-search').addEventListener('click', () => {
      document.getElementById('search-overlay').classList.add('active');
    });
    document.getElementById('btn-close-search').addEventListener('click', () => {
      document.getElementById('search-overlay').classList.remove('active');
    });

    // Инициализация при старте
    setLanguage(currentLang);
    displayQuote(0);
    loadHabits();
    loadReflection();
    renderCalendar();
    loadDayTasks();
    renderSpiritualEvent();
    renderFavorites();
    updateComparison();
    renderGlossary(glossaryTerms);
    renderReflectionArchive();
    updateXPUI();
    lucide.createIcons();
  </script>
</body>
</html>
