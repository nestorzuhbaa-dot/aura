        <div class="badges-grid">
          <div class="badge-item">
            <div class="badge-icon">🌿</div>
            <b>Истоки</b>
            <div style="color:var(--text-secondary); font-size:10px;">Пройден Месяц 1</div>
          </div>
          <div class="badge-item">
            <div class="badge-icon">📜</div>
            <b>Авраамист</b>
            <div style="color:var(--text-secondary); font-size:10px;">Пройден Месяц 2</div>
          </div>
          <div class="badge-item">
            <div class="badge-icon">🏛️</div>
